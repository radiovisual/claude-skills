    "inputs": [
      "fixtures/semver-release/release-breaking-bang/repo-state.txt"
    ],
    "grader": "contract",
    "references": [
      "reference_outputs/semver-release/release-breaking-bang/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/semver-release/release-breaking-bang/bad-1.txt",
        "fails": [
          "next-version",
          "tag",
          "bump"
        ]
      },
      {
        "path": "reference_outputs/semver-release/release-breaking-bang/bad-2.txt",
        "fails": [
          "breaking-first"
        ]
      }
    ],
    "assertions": [
      {
        "id": "action",
        "op": "equals",
        "path": [
          "action"
        ],
        "value": "release",
        "description": "Action is release"
      },
      {
        "id": "current-version",
        "op": "equals",
        "path": [
          "current_version"
        ],
        "value": "1.8.3",
        "description": "Current version is 1.8.3"
      },
      {
        "id": "next-version",
        "op": "equals",
        "path": [
          "next_version"
        ],
        "value": "2.0.0",
        "description": "Next version is 2.0.0"
      },
      {
        "id": "tag",
        "op": "equals",
        "path": [
          "tag"
        ],
        "value": "v2.0.0",
        "description": "Tag is v2.0.0"
      },
      {
        "id": "bump",
        "op": "equals",
        "path": [
          "bump"
        ],
        "value": "major",
        "description": "Bump is major"
      },
      {
        "id": "breaking-first",
        "op": "matches",
        "path": [
          "notes"
        ],
        "value": "(?is)\\s*##[^\\n]*breaking[^\\n]*\\n.*(timeout).*## fixes.*",
        "description": "Breaking changes come first and explain the renamed key"
      }
    ]
  },
