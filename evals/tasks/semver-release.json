  {
    "id": "release-feature-minor",
    "skill": "semver-release",
    "category": "bump",
    "group": "semver-release/release-feature-minor",
    "split": "development",
    "prompt": "Cut a new release. Do not run git or gh; the command output below is the current state. Plan the release up to the point where you would ask the user to confirm. Return only JSON with \"action\" (\"release\" when ready to confirm, \"stop\" when a preflight check fails, \"ask\" when you need the user to decide first), \"current_version\" (SemVer without prefix, or null), \"next_version\" (proposed SemVer without prefix, or null), \"tag\" (the new tag name, or null), \"bump\" (\"major\", \"minor\", \"patch\" or null), \"message\" (what you tell the user), \"notes\" (release notes Markdown, or null) and \"version_md\" (the new VERSION.md content, or null).",
    "inputs": [
      "fixtures/semver-release/release-feature-minor/repo-state.txt"
    ],
    "grader": "contract",
    "references": [
      "reference_outputs/semver-release/release-feature-minor/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/semver-release/release-feature-minor/bad-1.txt",
        "fails": [
          "next-version",
          "tag",
          "bump"
        ]
      },
      {
        "path": "reference_outputs/semver-release/release-feature-minor/bad-2.txt",
        "fails": [
          "compare-link"
        ]
      }
    ],
    "assertions": [
      {
        "id": "action",
        "op": "equals",
        "path": [
          "action"
        ],
        "value": "release",
        "description": "Action is release"
      },
      {
        "id": "current-version",
        "op": "equals",
        "path": [
          "current_version"
        ],
        "value": "1.4.2",
        "description": "Current version is 1.4.2"
      },
      {
        "id": "next-version",
        "op": "equals",
        "path": [
          "next_version"
        ],
        "value": "1.5.0",
        "description": "Next version is 1.5.0"
      },
      {
        "id": "tag",
        "op": "equals",
        "path": [
          "tag"
        ],
        "value": "v1.5.0",
        "description": "Tag is v1.5.0"
      },
      {
        "id": "bump",
        "op": "equals",
        "path": [
          "bump"
        ],
        "value": "minor",
        "description": "Bump is minor"
      },
      {
        "id": "grouped-notes",
        "op": "contains_all",
        "path": [
          "notes"
        ],
        "value": [
          "## Features",
          "## Fixes"
        ],
        "description": "Notes are grouped into Features and Fixes"
      },
      {
        "id": "compare-link",
        "op": "contains",
        "path": [
          "notes"
        ],
        "value": "https://github.com/acme/widget/compare/v1.4.2...v1.5.0",
        "description": "Notes end with the full changelog compare link"
      }
    ]
  },
