[
  {
    "id": "pr-on-base-branch",
    "skill": "piv-create-pr",
    "category": "guards",
    "group": "piv-create-pr/pr-on-base-branch",
    "split": "development",
    "prompt": "Open a PR for my work. Do not run git or gh; the command output below is the current state. Return only JSON with \"action\" (\"create\" or \"stop\"), \"message\" (what you tell the user), \"base\" (the base branch), \"existing_pr_url\" (string or null), \"title\" (string or null), \"body\" (string or null) and \"draft\" (boolean).",
    "inputs": [
      "fixtures/piv-create-pr/pr-on-base-branch/git-state.txt"
    ],
    "grader": "contract",
    "references": [
      "reference_outputs/piv-create-pr/pr-on-base-branch/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/piv-create-pr/pr-on-base-branch/bad-1.txt",
        "fails": [
          "stops"
        ]
      },
      {
        "path": "reference_outputs/piv-create-pr/pr-on-base-branch/bad-2.txt",
        "fails": [
          "base"
        ]
      }
    ],
    "assertions": [
      {
        "id": "stops",
        "op": "equals",
        "path": [
          "action"
        ],
        "value": "stop",
        "description": "Stops instead of opening a PR"
      },
      {
        "id": "base",
        "op": "equals",
        "path": [
          "base"
        ],
        "value": "main"
      }
    ]
  },
