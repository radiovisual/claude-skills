  {
    "id": "pr-report-deviations",
    "skill": "piv-create-pr",
    "category": "body",
    "group": "piv-create-pr/pr-report-deviations",
    "split": "development",
    "prompt": "Implementation is done and committed. Open the PR for review. Do not run git or gh; the command output below is the current state. Return only JSON with \"action\" (\"create\" or \"stop\"), \"message\" (what you tell the user), \"base\" (the base branch), \"existing_pr_url\" (string or null), \"title\" (string or null), \"body\" (string or null) and \"draft\" (boolean).",
    "inputs": [
      "fixtures/piv-create-pr/pr-report-deviations/git-state.txt",
      "fixtures/piv-create-pr/pr-report-deviations/.claude/reports/session-cache-report.md"
    ],
    "grader": "contract",
    "references": [
      "reference_outputs/piv-create-pr/pr-report-deviations/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/piv-create-pr/pr-report-deviations/bad-1.txt",
        "fails": [
          "deviation-in-notes"
        ]
      },
      {
        "path": "reference_outputs/piv-create-pr/pr-report-deviations/bad-2.txt",
        "fails": [
          "deviation-in-notes"
        ]
      }
    ],
    "assertions": [
      {
        "id": "creates",
        "op": "equals",
        "path": [
          "action"
        ],
        "value": "create",
        "description": "Opens the PR"
      },
      {
        "id": "typed-title",
        "op": "matches",
        "path": [
          "title"
        ],
        "value": "(\\[[A-Z]+-\\d+\\] )?(feat|fix|refactor|docs|test|chore|perf|build|ci)(\\([^)]+\\))?!?: \\S.*",
        "description": "Title is {type}: {description}"
      },
      {
        "id": "default-sections",
        "op": "contains_all",
        "path": [
          "body"
        ],
        "value": [
          "## Summary",
          "## What changed",
          "## Validation",
          "## Notes for the reviewer",
          "## Linked"
        ],
        "description": "Body uses the default template sections"
      },
      {
        "id": "deviation-in-notes",
        "op": "matches",
        "path": [
          "body"
        ],
        "value": "(?is).*## Notes for the reviewer[^#]*(lru|redis|in-process)[^#]*## Linked.*",
        "description": "The documented deviation appears under Notes for the reviewer"
      }
    ]
  },
  {
    "id": "pr-linked-ticket",
    "skill": "piv-create-pr",
    "category": "body",
    "group": "piv-create-pr/pr-linked-ticket",
    "split": "holdout",
    "prompt": "Open a pull request for this ticket. Do not run git or gh; the command output below is the current state. Return only JSON with \"action\" (\"create\" or \"stop\"), \"message\" (what you tell the user), \"base\" (the base branch), \"existing_pr_url\" (string or null), \"title\" (string or null), \"body\" (string or null) and \"draft\" (boolean).",
    "inputs": [
      "fixtures/piv-create-pr/pr-linked-ticket/git-state.txt"
    ],
    "grader": "contract",
    "references": [
      "reference_outputs/piv-create-pr/pr-linked-ticket/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/piv-create-pr/pr-linked-ticket/bad-1.txt",
        "fails": [
          "linked-refs"
        ]
      },
      {
        "path": "reference_outputs/piv-create-pr/pr-linked-ticket/bad-2.txt",
        "fails": [
          "linked-refs"
        ]
      }
    ],
    "assertions": [
      {
        "id": "creates",
        "op": "equals",
        "path": [
          "action"
        ],
        "value": "create",
        "description": "Opens the PR"
      },
      {
        "id": "typed-title",
        "op": "matches",
        "path": [
          "title"
        ],
        "value": "(\\[[A-Z]+-\\d+\\] )?(feat|fix|refactor|docs|test|chore|perf|build|ci)(\\([^)]+\\))?!?: \\S.*",
        "description": "Title is {type}: {description}"
      },
      {
        "id": "linked-refs",
        "op": "matches",
        "path": [
          "body"
        ],
        "value": "(?is).*## Linked[^#]*(ACC-212[^#]*#88|#88[^#]*ACC-212).*",
        "description": "Links both the branch ticket and the issue fixed by a commit"
      }
    ]
  },
  {
