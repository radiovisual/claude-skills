    "split": "development",
    "prompt": "Open the PR for this branch, following our project conventions. Do not run git or gh; the command output below is the current state. Return only JSON with \"action\" (\"create\" or \"stop\"), \"message\" (what you tell the user), \"base\" (the base branch), \"existing_pr_url\" (string or null), \"title\" (string or null), \"body\" (string or null) and \"draft\" (boolean).",
    "inputs": [
