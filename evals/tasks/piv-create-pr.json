  {
    "id": "pr-detect-base",
    "skill": "piv-create-pr",
    "category": "base-branch",
    "group": "piv-create-pr/pr-detect-base",
    "split": "development",
    "prompt": "Open the PR for this branch. Do not run git or gh; the command output below is the current state. Return only JSON with \"action\" (\"create\" or \"stop\"), \"message\" (what you tell the user), \"base\" (the base branch), \"existing_pr_url\" (string or null), \"title\" (string or null), \"body\" (string or null) and \"draft\" (boolean).",
    "inputs": [
      "fixtures/piv-create-pr/pr-detect-base/git-state.txt"
    ],
    "grader": "contract",
    "references": [
      "reference_outputs/piv-create-pr/pr-detect-base/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/piv-create-pr/pr-detect-base/bad-1.txt",
        "fails": [
          "detected-base"
        ]
      },
      {
        "path": "reference_outputs/piv-create-pr/pr-detect-base/bad-2.txt",
        "fails": [
          "detected-base"
        ]
      }
    ],
    "assertions": [
      {
        "id": "creates",
        "op": "equals",
        "path": [
          "action"
        ],
        "value": "create",
        "description": "Opens the PR"
      },
      {
        "id": "detected-base",
        "op": "equals",
        "path": [
          "base"
        ],
        "value": "develop",
        "description": "Uses origin/HEAD instead of assuming main"
      },
      {
        "id": "typed-title",
        "op": "matches",
        "path": [
          "title"
        ],
        "value": "(\\[[A-Z]+-\\d+\\] )?(feat|fix|refactor|docs|test|chore|perf|build|ci)(\\([^)]+\\))?!?: \\S.*",
        "description": "Title is {type}: {description}"
      }
    ]
  },
