      },
      {
        "id": "conventional-tag",
        "op": "matches",
        "path": [
          "message"
        ],
        "value": "(?s)(feat|fix|chore|ci|build)(\\([^)\\n]+\\))?!?: [^\\n]+(\\n.*)?",
        "description": "First line is <tag>: <summary> with tag feat|fix|chore|ci|build"
      },
      {
        "id": "what-changed",
        "op": "length",
        "path": [
          "what_changed"
