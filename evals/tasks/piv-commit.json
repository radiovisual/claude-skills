            "op": "equals",
            "path": [
              "path"
            ],
            "value": ".claude/skills/deploy/SKILL.md"
          },
          {
            "id": "note",
            "op": "length",
            "path": [
              "note"
            ],
            "min": 1
          }
        ],
        "description": "Notes the deploy skill change"
      },
      {
        "id": "ai-layer-conventions",
        "op": "any",
        "path": [
          "ai_layer_changes"
        ],
        "checks": [
          {
            "id": "path",
            "op": "equals",
            "path": [
              "path"
            ],
            "value": ".claude/references/conventions.md"
          },
          {
            "id": "note",
            "op": "length",
            "path": [
              "note"
            ],
            "min": 1
          }
        ],
        "description": "Notes the new conventions reference"
      }
    ]
