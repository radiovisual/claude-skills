  {
    "id": "commit-docs-untracked",
    "skill": "piv-commit",
    "category": "staging",
    "group": "piv-commit/commit-docs-untracked",
    "split": "development",
    "prompt": "Commit all of our uncommitted work. Do not run git; work from the repository state below. Return only JSON with \"files_to_stage\" (repository paths to add), \"message\" (the full commit message), \"what_changed\" (the summary paragraph) and \"ai_layer_changes\" (array of {\"path\", \"note\"}; an empty array when there are none).",
    "inputs": [
      "fixtures/piv-commit/commit-docs-untracked/repo-state.txt"
    ],
    "grader": "contract",
    "references": [
      "reference_outputs/piv-commit/commit-docs-untracked/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/piv-commit/commit-docs-untracked/bad-1.txt",
        "fails": [
          "stage-all"
        ]
      },
      {
        "path": "reference_outputs/piv-commit/commit-docs-untracked/bad-2.txt",
        "fails": [
          "conventional-tag"
        ]
      }
    ],
    "assertions": [
      {
        "id": "stage-all",
        "op": "set_equals",
        "path": [
          "files_to_stage"
        ],
        "value": [
          "README.md",
          "docs/setup.md"
        ],
        "description": "Stages every changed and untracked file, and nothing else"
      },
      {
        "id": "conventional-tag",
        "op": "matches",
        "path": [
          "message"
        ],
        "value": "(?s)(docs)(\\([^)\\n]+\\))?!?: [^\\n]+(\\n.*)?",
        "description": "First line is <tag>: <summary> with tag docs"
      },
      {
        "id": "what-changed",
        "op": "length",
        "path": [
          "what_changed"
        ],
        "min": 40,
        "description": "Includes a What Changed summary"
      }
    ]
  },
