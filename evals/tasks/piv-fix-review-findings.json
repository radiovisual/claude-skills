    "prompt": "Apply this PR review. Fix critical and high findings now; defer medium and low. Do not edit files; decide what you would do. Return only JSON with \"fix_now\", \"defer\", \"needs_human\", \"noise\" (arrays of finding IDs), \"ask_user\" (boolean: stop and ask how to triage before fixing), \"fixes\" (array of {\"id\", \"what_was_wrong\", \"test\"} for findings you fix), \"issues_to_create\" (finding IDs to log in the tracker), \"run_validation\" (boolean) and \"commit_and_push\" (boolean).",
    "inputs": [
      "fixtures/piv-fix-review-findings/fix-severity-scope/context.txt",
      "fixtures/piv-fix-review-findings/fix-severity-scope/review.md"
    ],
    "grader": "contract",
    "references": [
      "reference_outputs/piv-fix-review-findings/fix-severity-scope/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/piv-fix-review-findings/fix-severity-scope/bad-1.txt",
        "fails": [
          "fix-now",
          "defer",
          "test-for-F2"
        ]
      },
      {
        "path": "reference_outputs/piv-fix-review-findings/fix-severity-scope/bad-2.txt",
        "fails": [
          "fix-now",
          "defer"
        ]
      }
    ],
    "assertions": [
      {
        "id": "fix-now",
        "op": "set_equals",
        "path": [
          "fix_now"
        ],
        "value": [
          "F2",
          "F3"
        ],
        "description": "fix_now is exactly ['F2', 'F3']"
      },
      {
        "id": "defer",
        "op": "set_equals",
        "path": [
          "defer"
        ],
        "value": [
          "F1",
          "F4"
        ],
        "description": "defer is exactly ['F1', 'F4']"
      },
      {
        "id": "test-for-F2",
        "op": "any",
        "path": [
          "fixes"
        ],
        "checks": [
          {
            "id": "id",
            "op": "equals",
            "path": [
              "id"
            ],
            "value": "F2"
          },
          {
            "id": "test",
            "op": "length",
            "path": [
              "test"
            ],
            "min": 1
          }
        ],
        "description": "F2 is fixed with a test"
      },
      {
        "id": "test-for-F3",
        "op": "any",
        "path": [
          "fixes"
        ],
        "checks": [
          {
            "id": "id",
            "op": "equals",
            "path": [
              "id"
            ],
            "value": "F3"
          },
          {
            "id": "test",
            "op": "length",
            "path": [
              "test"
            ],
            "min": 1
          }
        ],
        "description": "F3 is fixed with a test"
      }
    ]
  }
]
